#!/usr/bin/env xetal
# The shared libraries tested together: each function on a small case
# whose answer can be checked by eye. Run by scripts/test-lib.sh against
# lib/expected/test.out (and test.in for the keyboard).
"b:" u_se< "Board"
"p:" u_se< "Play"
"s:" u_se< "State"
"t:" u_se< "Text"

# Board: squares and rows/columns, both ways, one or many.
8 b:c_ell 2 5
8 b:c_ell 2 3 r_eshape 0 1 7 0 1 7
8 b:r_c 1 2 64
# Neighbours: a corner, an edge and the middle of a 3 by 4 board.
b:a_round 3 4 r_eshape 1 0 0 1 0 0 0 0 0 1 0 0
b:p_lus 3 3 r_eshape 0 0 0 0 1 0 0 0 0
b:s_paced 2 3 r_eshape "abcdef"

# State: two items changed at once; a stretch replaced.
10 20 30 40 50 s:u_pdate 2 0 5 9
10 20 30 40 50 s:p_ut 2 7 8

# Text: lines printed; the rows of a table for a key and a state.
said := t:l_ines "one" "two"
kfv := 3 4 r_eshape 1 1 2 2 0 2 0 2 0 1 0 0
w_here ((1 s_elect kfv) m_ember? 1) & kfv t:h_olds 0 1
w_here ((1 s_elect kfv) m_ember? 1 2) & kfv t:h_olds 0 0

# Play: a number, all the numbers, a letter (from lib/expected/test.in).
p:n_umber "A NUMBER ?"
p:n_umbers "SOME NUMBERS ?"
p:n_umber "NOTHING ?"
"MOVE ?" p:l_etter "adws"
p:l_ine "A LINE ?"
p:n_umbersIn "row 3, column 12"
