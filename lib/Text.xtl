## Text: printing lines, shared by the games.

# :: Num b => Box a -> b
## Print each string of a strand on its own line; how many were printed.
## >> "t:" u_se< "Text"
## >> t:l_ines "one" "two"
## one
## two
## 2
l:l_ines := { v ->
  0 = t_ally v ? 0
  said := p_rint! d_isclose f_irst v
  1 + l:l_ines 1 d_rop v
}
# :: Truthy a => Int -> Int -> a
## Which rows of a text table hold in state s: a row's condition is a
## state item (0: always) and the value it must have, the second and
## third rows of kfv (the first row, the keys, is for the caller to
## match: w_here (keys m_ember? k) & kfv t:h_olds s).
## >> "t:" u_se< "Text"
## >> (3 4 r_eshape 1 1 2 2 0 2 0 2 0 1 0 0) t:h_olds 0 1
## 1 1 1 0
l:h_olds := { kfv s ->
  f := 2 s_elect kfv
  (f = 0) | (3 s_elect kfv) = (1 + f) s_elect -1 c_at s
}
# :: Box Char -> Char
## The boxed texts b joined into one text, in pairs, level by level: each
## level copies the text once, so n texts cost n log n, not the n squared
## of a reduce with c_at (X_eTaL has no built-in join yet: an ask).
## >> "t:" u_se< "Text"
## >> t:j_oin "ab" "c" "def"
## abcdef
l:j_oin := { b ->
  0 = t_ally b ? ""
  1 = t_ally b ? d_isclose f_irst b
  e := b c_at (2 m_od t_ally b) r_eshape e_nclose ""
  odd := (2 * r_ange (t_ally e) d_iv 2) - 1
  l:j_oin (odd s_elect e) '{ x y -> e_nclose (d_isclose x) c_at d_isclose y } e_ach (odd + 1) s_elect e
}
