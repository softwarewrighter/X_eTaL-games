#!/usr/bin/env xetal
## Asteroids: break every rock, three waves of them. Left and right (or
## a and d) turn the ship, up (or w) thrusts, the space bar (or f) fires;
## a big rock breaks into two medium ones, a medium into two small; a
## rock that hits the ship costs a life; r starts again. The game moves
## with the clock: on the page it is in a dialog, and the clock's ticks
## (twenty a second) and your keys come to the program as events; at the
## command line, lines such as "tick 0.05", "key LEFT" and "key space"
## on standard input. When every wave is cleared or the lives are gone
## the program ends with the score (on the page, Play or any key then
## starts a new game). The rules are Rocks.xtl's, built on lib/Ecs.
"ro:" u_se< "Rocks"

## Show the game, then wait for the next event.
u:s_how := { s ->
  pic := []S_HOW ro:d_raw s
  0 < ro:s_tatus s ? u:e_nd s
  u:l_oop s
}
## The next event: a tick moves the game on and shows it; a key acts.
u:l_oop := { s ->
  e := []E_VENT @
  "end" m_atch []E_KIND e ? u:q_uit s
  "tick" m_atch []E_KIND e ? u:s_how s ro:t_ick f_irst []E_AT e
  n_ot "key" m_atch []E_KIND e ? u:l_oop s
  name := f_ormat []E_KEY e
  "r" m_atch name ? u:s_how ro:n_ew 0
  u:l_oop s ro:k_ey name
}
## The end of the events: the score so far.
u:q_uit := { s ->
  said := p_rint! @ f_ormat< "Score {f_irst ro:s_core s}, wave {3 s_elect ro:s_core s}, lives {2 s_elect ro:s_core s}."
  "THE END"
}
## How the game ended (the program ends with it).
u:e_nd := { s ->
  sc := f_irst ro:s_core s
  1 = ro:s_tatus s ? @ f_ormat< "Every wave cleared! You scored {sc}."
  @ f_ormat< "Game over. You scored {sc}."
}
u:s_how ro:n_ew 0
