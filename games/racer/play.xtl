#!/usr/bin/env xetal
## The racer: three laps against three rivals. Up (or w) speeds you up,
## down (or s) slows you, left and right (or a and d) steer; keep off the
## grass, which slows you; r starts again. The race moves with the
## clock: on the page it is in a dialog, and the clock's ticks (twenty a
## second) and your keys come to the program as events; at the command
## line, lines such as "tick 0.05" and "key UP" on standard input. When
## you finish the program ends with your place (on the page, Play or any
## key then starts a new race). The rules are Race.xtl's, built on
## lib/Ecs.
"rc:" u_se< "Race"

## Show the game, then wait for the next event.
u:s_how := { s ->
  pic := []S_HOW rc:d_raw s
  0 < rc:s_tatus s ? u:e_nd s
  u:l_oop s
}
## The next event: a tick moves the game on and shows it; a key acts.
u:l_oop := { s ->
  e := []E_VENT @
  "end" m_atch []E_KIND e ? "THE END"
  "tick" m_atch []E_KIND e ? u:s_how s rc:t_ick f_irst []E_AT e
  n_ot "key" m_atch []E_KIND e ? u:l_oop s
  name := f_ormat []E_KEY e
  "r" m_atch name ? u:s_how rc:n_ew 0
  u:l_oop s rc:k_ey name
}
## How the race ended (the program ends with it).
u:e_nd := { s ->
  p := rc:p_lace s
  1 = p ? "You won the race!"
  @ f_ormat< "You finished in place {p}."
}
u:s_how rc:n_ew 0
