#!/usr/bin/env xetal
## 2048, scripted (seed 1), with the rules of Twenty48.xtl.
"t:" u_se< "Twenty48"

# A board, every row slid left at once: compress (running counts and a
# 4 by 4 by 4 table), merge (places in runs of equal tiles, by a
# max-scan), compress again.
b := 4 4 r_eshape 2 2 2 2 0 2 0 2 4 4 8 8 2 0 0 4
t:c_ompress b
t:p_lace t:c_ompress b
t:d_oubles t:c_ompress b
t:l_eft b
b t:g_ain 1                              # the merged tiles' values

# The other moves turn the board, move left, and turn it back.
b t:s_lide 2
b t:s_lide 3
b t:s_lide 4

## A whole game by a simple corner player: left, then down, then right,
## then up, the first of them that moves anything.
u:p_ick := { s ->
  ok := '{ n_ot (s t:m_ove _r) m_atch s } e_ach 1 4 2 3
  f_irst (ok r_eplicate 1 4 2 3) c_at 1
}
u:g_ame := { s ->
  0 < t:s_tatus s ? s
  u:g_ame s t:m_ove u:p_ick s
}
end := u:g_ame t:n_ew 0
t:b_oard end
t:s_core end
t:s_tatus end                            # 2: no move left

# What the game guarantees, checked by a_ssert< (the condition as
# written; silent when it holds, a line on standard error, which fails
# the tests, when it does not).
ok := "('+ r_/ r_avel b) = '+ r_/ r_avel b t:s_lide 2" a_ssert< "a slide keeps the tiles' total"
ok := "2 = t:s_tatus end" a_ssert< "the game ends with no move left"
