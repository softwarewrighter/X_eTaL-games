#!/usr/bin/env xetal
# Capitals, scripted (seed 1), with the rules and the drawing of
# Atlas.xtl: the places read from TOML, every distance at once, the
# map drawn as SVG, and a round played by clicks given as points.
"a:" u_se< "Atlas"

# The places: Natural Earth's national capitals, then any of your own
# from places.toml; how many in each region (0 is all of them).
a:r_egions @
'{ r -> t_ally a:p_ool r } e_ach 0 1 2 3 4 5

# Paris: its point on the map (map units: hundredths of a degree east
# of 180 W and south of the pole), and its four choices, the nearest
# cities with different names, west to east (the nearest is Paris).
p := f_irst w_here '{ i -> "Paris, France" m_atch a:n_ame i } e_ach a:p_ool 0
a:n_ame p
f_loor a:a_t p
'{ k -> e_nclose a:t_own k } e_ach a:c_hoices p

# What the map shows for Europe: x, y, width and height, around its
# capitals.
f_loor a:v_iew 4

# A round in Europe (seed 1): five capitals drawn at random, and the
# picture X_eTaL draws for it.
s := a:n_ew 4
'{ i -> e_nclose a:n_ame i } e_ach a:d_ots s
pic := []S_HOW a:d_raw s

# A click on the first dot opens its menu; a click on the right name
# (the middle of its button) answers it.
i := f_irst a:d_ots s
t := s a:c_lick a:a_t i
a:s_ay t
k := f_irst w_here (a:c_hoices i) = a:a_nswer i
b := k s_elect a:m_enu t
t := t a:c_lick ((f_irst b) + 0.5 * 3 s_elect b) c_at (2 s_elect b) + 0.5 * 4 s_elect b
a:s_ay t
pic := []S_HOW a:d_raw t
a:s_core t
