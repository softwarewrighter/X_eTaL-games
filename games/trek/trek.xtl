#!/usr/bin/env xetal
## Star Trek, scripted (seed 1), with the rules of StarTrek.xtl.
"t:" u_se< "StarTrek"

# A new game. The galaxy was made all at once: three 8 by 8 planes, the
# Klingons, the bases and the stars in every quadrant.
start := t:n_ew 0
start t:g_alaxy 1
start t:g_alaxy 2
start t:g_alaxy 3
t:k_lingons start
s := t:l_rs t:s_rs start

# A course is a step from the compass table; a path is every step at
# once: course 3 (east) for 5 sectors from where the Enterprise is.
t:c_ourses @
P := s t:p_ath 3 5
P
t:i_nside P
(t:c_ells P) s_elect r_avel t:g_rid s          # what lies on each step

# Warp east into the next quadrant, then fight: phasers hit every
# Klingon at once, a torpedo flies its whole track at once.
warped := s t:c_ommand 3 3 1
fought := ((warped t:c_ommand 6 6) t:c_ommand 5 10) t:c_ommand 8
t:s_tatus fought

## The game ends when the stardate runs out: warp is one stardate a
## factor.
u:f_ar := { s -> s t:c_ommand 3 5 8 }
late := 4 'u:f_ar p_ower fought
t:s_tatus late                                # 2: out of time
t:e_nd late

# What the game guarantees, checked by a_ssert< (the condition as
# written; silent when it holds, a line on standard error, which fails
# the tests, when it does not).
_ := "2 = t:s_tatus late" a_ssert< "the long voyage runs out of time"
_ := "0 <= t:k_lingons late" a_ssert< "never fewer than no Klingons"
