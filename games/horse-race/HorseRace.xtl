# The horse race's rules, a library: horse-race.xtl (a scripted race),
# play.xtl (at the terminal) and the web page all use these, so the
# rules are written once. Five horses, a track of 15; every round each
# horse runs 1, 2 or 3 at random, all at once: the field is one vector
# of positions and a round is one expression. The first round in which
# any horse reaches the finish ends the race; the horses furthest along
# win (there can be a tie).

l:finish := 15
# The horses' names, one per row.
l:n_ames := { @ -> 5 7 r_eshape "LUCKY  THUNDERSHADOW COMET  BLAZE  " }

# A new race: n horses at the start.
l:n_ew := { n -> n r_eshape 0 }
# A round's rolls: 1 to 3 for every horse at once.
l:r_oll := { p -> r_oll! (t_ally p) r_eshape 3 }
# A round: every horse moves by its roll.
l:m_ove := { p r -> p + r }
# 0 while the race is on, 1 once any horse reaches the finish.
l:s_tatus := { p -> '| r_/ p >= l:finish }
# The winners: every horse as far along as the leader.
l:w_inners := { p -> w_here p = 'm_ax r_/ p }
# The track: each horse's name, a rail, a bar as long as its position,
# the finish line where no horse has reached it yet, and, once the race
# is over, a mark on every winner's row.
l:v_iew := { p ->
  cols := r_ange l:finish + 5
  bar := (p m_in l:finish + 5) '>= t_able cols
  line := (0 * p) '+ t_able 1 * cols = l:finish
  won := (l:s_tatus p) * p = 'm_ax r_/ p
  mark := (1 + won) s_elect 2 10 r_eshape "           <- WINNER"
  (l:n_ames @) c_at_2 (f_irst "|") c_at_2 ((1 + bar + 2 * line * 1 - bar) s_elect " #:") c_at_2 mark
}
