## The dungeon's rules, a library: dungeon.xtl (scripted), play.xtl (the
## game: arrow keys) and the web page all use these. Built on lib/Ecs: a
## world is a matrix, a row per entity, and every rule is a system, one
## expression over every entity with the components it needs. You, the
## monsters and the things to pick up are entities; what each one is
## comes from its components (dungeon.toml gives each kind its own), so
## a new kind of monster or item is a new table there, not new code here.
## A game's state is a tuple: (the world, the gold found, the turns
## taken, what just happened).

"ec:" u_se< "Ecs"
"sv:" u_se< "Svg"
"t:" u_se< "Text"

### The data

## The layout: where it is, how much it can take and how hard it hits,
## its kind, whether it comes after you, and what it gives when picked up
## (or drops when beaten).
"h" ec:c_omponents< "pos:2 hp atk kind chase heal gold player"
## A cell's first character, and a column of the kinds' table as numbers.
h:f_irstChar := { x -> f_irst d_isclose x }
h:c_olumn := { j -> 'sv:n_um e_ach j s_elect_2 kinds }
## The map: 9 rows of 25, from dungeon.toml.
grid := 9 25 r_eshape t:j_oin "dungeon.toml" []L_IST "map"
walls := grid = f_irst "#"
kinds := ("dungeon.toml" "kind") []T_ABLE ("kinds" "fields")
glyphs := 'h:f_irstChar e_ach 1 s_elect_2 kinds
colors := 7 s_elect_2 kinds
## Your numbers, then each kind's (you are kind 1, the kinds 2 on): hit
## points, attack, chase, heal, gold.
you := 'sv:n_um e_ach "dungeon.toml" []L_IST "player"
HP := (f_irst you) c_at h:c_olumn 2
AT := (2 s_elect you) c_at h:c_olumn 3
CH := 0.0 c_at h:c_olumn 4
HE := 0.0 c_at h:c_olumn 5
GO := 0.0 c_at h:c_olumn 6

### A new game

# :: (Any a, Num b, Num c) => a -> (Float, b, c, Char)
## The world from the map: an entity for you and for every glyph of a
## kind, each given its kind's components, all at once (a kind with no
## heal has no heal component, and so on).
l:n_ew := { x ->
  cells := w_here (r_avel grid) m_ember? "@" c_at glyphs
  k := ("@" c_at glyphs) i_ndexOf cells s_elect r_avel grid
  (W, ids) := (h:w_orld 32) ec:s_pawn t_ally cells
  W := W h:s_etPos (ids, f_loat o_\ (2 c_at t_ally cells) r_eshape ((cells - 1) d_iv 25) c_at (cells - 1) m_od 25)
  W := W h:s_etKind (ids, f_loat k - 1)
  W := W h:s_etPlayer (f_irst ids, 1.0)
  W := W h:p_utSome (ids, k, HP, 1)
  W := W h:p_utSome (ids, k, AT, 2)
  W := W h:p_utSome (ids, k, CH, 3)
  W := W h:p_utSome (ids, k, HE, 4)
  W := W h:p_utSome (ids, k, GO, 5)
  (W, 0, 0, "Find the way out (>). Arrow keys or WASD to move; walk into a monster to fight.")
}
## Component c (1 hp, 2 atk, 3 chase, 4 heal, 5 gold) for the entities
## ids whose kind k gives it a value above 0, every one at once.
h:p_utSome := { W (ids, k, v, c) ->
  x := k s_elect v
  on := w_here x > 0
  c = 1 ? W h:s_etHp (on s_elect ids, on s_elect x)
  c = 2 ? W h:s_etAtk (on s_elect ids, on s_elect x)
  c = 3 ? W h:s_etChase (on s_elect ids, on s_elect x)
  c = 4 ? W h:s_etHeal (on s_elect ids, on s_elect x)
  W h:s_etGold (on s_elect ids, on s_elect x)
}

### The systems

## The sign of each number: 1, 0 or -1.
h:s_ign := { x -> (x > 0) - x < 0 }
## A cell's number (1 to 225) from its row and column (from 0), many at
## once (rows of a matrix, row then column).
h:c_ell := { P -> 1 + (25 * f_loor 1 s_elect_2 P) + f_loor 2 s_elect_2 P }
## Which entities are at the point p (a row and a column).
h:a_t := { W p -> '& r_/_2 (h:p_os W) = ((t_ally W) c_at 2) r_eshape p }
## The fighters other than you, alive.
h:f_oes := { W -> w_here (ec:a_live W) & (h:h_asHp W) & 0 = h:p_layer W }
## Your entity.
h:m_e := { W -> f_irst w_here 0 < h:p_layer W }

# :: (Num a, Any b) => (Float, Int, a, b) -> Float -> (Float, Int, a, Char)
## A turn: you move by d (a row and a column step) or hit the monster in
## the way, then pick up what lies where you stand, the beaten monsters
## drop their gold and go, and every monster that sees you comes a step
## closer or hits you: each a system over every entity at once.
l:t_urn := { (W, g, n, m) d ->
  me := h:m_e W
  to := (me s_elect h:p_os W) + d
  foe := w_here (ec:a_live W) & (h:h_asHp W) & (0 = h:p_layer W) & W h:a_t to
  wall := (h:c_ell 1 2 r_eshape to) s_elect r_avel walls
  (W, said) := h:y_ou (W, me, to, foe, f_irst wall)
  (W, g, picked) := h:p_ickUp (W, g, me)
  (W, g, beaten) := h:b_eaten (W, g)
  (W, hurt) := h:m_onsters (W, me)
  (W, g, n + 1, t:j_oin (e_nclose said) c_at picked c_at beaten c_at e_nclose hurt)
}
## You: a hit on the monster in the way, else a step (not into a wall).
h:y_ou := { (W, me, to, foe, wall) ->
  0 < t_ally foe ? (W h:s_etHp (foe, (foe s_elect h:h_p W) - me s_elect h:a_tk W), "You hit it. ")
  wall ? (W, "A wall. ")
  (W h:s_etPos (me, to), "")
}
## What lies where you stand, picked up: hit points back, gold found;
## the items go.
h:p_ickUp := { (W, g, me) ->
  here := w_here (ec:a_live W) & (n_ot h:h_asHp W) & ((h:h_asHeal W) | h:h_asGold W) & W h:a_t me s_elect h:p_os W
  0 = t_ally here ? (W, g, 0 r_eshape e_nclose "")
  heal := '+ r_/ here s_elect h:h_eal W
  gold := '+ r_/ here s_elect h:g_old W
  W := W h:s_etHp (me, heal + me s_elect h:h_p W)
  (W ec:d_espawn here, g + f_loor gold, e_nclose @ f_ormat< "You pick up {f_loor heal} hp and {f_loor gold} gold. ")
}
## The beaten monsters (no hit points left) drop their gold and go.
h:b_eaten := { (W, g) ->
  dead := ((h:f_oes W) s_elect 0 >= h:h_p W) r_eplicate h:f_oes W
  0 = t_ally dead ? (W, g, 0 r_eshape e_nclose "")
  (W ec:d_espawn dead, g + f_loor '+ r_/ dead s_elect h:g_old W, e_nclose "You beat it. ")
}
## Every monster that chases and is within 6 steps comes a step closer
## (the longer way first), all at once: not into a wall, nor into
## another, nor two into one cell; one next to you hits you instead.
h:m_onsters := { (W, me) ->
  ms := ((h:f_oes W) s_elect h:h_asChase W) r_eplicate h:f_oes W
  0 = t_ally ms ? (W, "")
  P := ms s_elect h:p_os W
  d := ((t_ally ms) c_at 2) r_eshape (me s_elect h:p_os W)
  d := d - P
  far := '+ r_/_2 a_bs d
  next := far = 1
  hit := '+ r_/ next r_eplicate ms s_elect h:a_tk W
  W := W h:s_etHp (me, (me s_elect h:h_p W) - hit)
  go := (far > 1) & far <= 6
  rowFirst := (a_bs 1 s_elect_2 d) >= a_bs 2 s_elect_2 d
  step := o_\ (2 c_at t_ally ms) r_eshape (rowFirst * h:s_ign 1 s_elect_2 d) c_at (n_ot rowFirst) * h:s_ign 2 s_elect_2 d
  Q := P + f_loat step * go '* t_able 1 1
  c := h:c_ell Q
  taken := h:c_ell (w_here (ec:a_live W) & h:h_asHp W) s_elect h:p_os W
  ok := go & (n_ot c s_elect r_avel walls) & (n_ot c m_ember? taken) & (c i_ndexOf c) = r_ange t_ally c
  Q := (P * f_loat n_ot ok '* t_able 1 1) + Q * f_loat ok '* t_able 1 1
  (W h:s_etPos (ms, Q), h:o_uch hit)
}
## What a monster's hit says.
h:o_uch := { hit ->
  0 = hit ? ""
  @ f_ormat< "It hits you for {f_loor hit}."
}

### What it shows

# :: (Num a, Any b, Any c, Any d, Num e) => (a, b, c, d) -> e
## 0 playing, 1 you found the way out, 2 you were beaten.
l:s_tatus := { (W, g, n, m) ->
  me := h:m_e W
  0 >= me s_elect h:h_p W ? 2
  (f_irst h:c_ell 1 2 r_eshape me s_elect h:p_os W) = f_irst w_here (r_avel grid) = f_irst ">" ? 1
  0
}
# :: (Num a, Any b) => (a, Int, Int, b) -> Int
## Your hit points, gold and turns.
l:y_ou := { (W, g, n, m) -> (f_loor (h:m_e W) s_elect h:h_p W) c_at g c_at n }
## A cell's fill: a wall, the floor, the way out.
h:f_ill := { c -> d_isclose (1 + (c = f_irst "#") + 2 * c = f_irst ">") s_elect "#22223b" "#4a4e69" "#2a9d8f" }
h:s_quare := { (x, y, w, h) k -> e_nclose @ f_ormat< "<rect x=\"{sv:w_hole x}\" y=\"{sv:w_hole y}\" width=\"100\" height=\"100\" fill=\"{h:f_ill k s_elect r_avel grid}\" stroke=\"#000000\" stroke-width=\"2\"/>" }
## The map, drawn once: 225 cells of 100 units, below a row for words.
floor := t:j_oin '{ k -> ((100.0 * f_loat (k - 1) m_od 25), (100.0 + 100.0 * f_loat (k - 1) d_iv 25), 100.0, 100.0) h:s_quare k } e_ach r_ange 225
## An entity's glyph and color: you an @, a kind its own.
h:g_lyph := { k -> 0 = k ? "@"; (k s_elect glyphs) c_at "" }
h:c_olor := { k -> 0 = k ? "#ffffff"; d_isclose k s_elect colors }
# :: (Float, Int, Int, a) -> Char
## The picture, as SVG text: what you have and what just happened, the
## map, and every entity alive as its glyph in its kind's color.
l:d_raw := { (W, g, n, m) ->
  v := 0.0 0.0 2500.0 1000.0
  y := l:y_ou (W, g, n, m)
  top := (20.0, 70.0, 44.0) sv:w_ords @ f_ormat< "HP {f_irst y}   Gold {2 s_elect y}   Turn {3 s_elect y}   {m}"
  live := w_here ec:a_live W
  P := live s_elect h:p_os W
  k := f_loor live s_elect h:k_ind W
  ents := '{ i -> e_nclose @ f_ormat< "<text class=\"entity\" x=\"{sv:w_hole 50 + 100 * i s_elect 2 s_elect_2 P}\" y=\"{sv:w_hole 180 + 100 * i s_elect 1 s_elect_2 P}\" font-size=\"84\" text-anchor=\"middle\" font-family=\"monospace\" font-weight=\"bold\" fill=\"{h:c_olor i s_elect k}\">{h:g_lyph i s_elect k}</text>" } e_ach r_ange t_ally live
  v sv:p_icture (v sv:r_ect "fill=\"#0b0b14\"") c_at (e_nclose floor) c_at ents c_at top
}
# :: (Num a, Any b, Any c, Any d, Num e, Truthy e) => (a, b, c, d) -> e
## Which components each living entity has, a row each: hit points,
## attack, chase, heal, gold (1 where it has it), from the masks the
## macro wrote.
l:h_as := { (W, g, n, m) ->
  M := o_\ (5 c_at t_ally W) r_eshape 0 + (h:h_asHp W) c_at (h:h_asAtk W) c_at (h:h_asChase W) c_at (h:h_asHeal W) c_at h:h_asGold W
  (w_here ec:a_live W) s_elect M
}
