#!/usr/bin/env xetal
## The dungeon, scripted (seed 1), with the rules of Crawl.xtl on
## lib/Ecs: the world as a matrix, what each entity is as the components
## it has, and every rule as one expression over all of them.
"cr:" u_se< "Crawl"
"ec:" u_se< "Ecs"

# A new game (seed 1): one of the maps, with you, the way out, two rats,
# two goblins, two potions and two piles of gold placed on its floor at
# random. The world: a row per entity slot (32) and a column per field
# (20: alive, then for each component whether the entity has it, then
# its fields); 10 entities are alive.
s := cr:n_ew 0
(W, g, n, m, lv) := s
s_hape W
ec:c_ount W

# What each entity is, as the components it has: a row each, a 1 where
# it has hit points, attack, chase, heal, gold (its kind's table in
# dungeon.toml gives it those; nothing in the code names a kind).
cr:h_as s

# A few turns (right twice, down twice, left twice): what happens is
# said, and the monsters that see you come closer.
u:g_o := { s d -> s cr:t_urn d }
s := s u:g_o 0 1.0
s := s u:g_o 0 1.0
s := s u:g_o 1 0.0
s := s u:g_o 1 0.0
s := s u:g_o 0 -1.0
s := s u:g_o 0 -1.0
(W, g, n, m, lv) := s
m
cr:y_ou s
pic := []S_HOW cr:d_raw s

# What the game guarantees, checked by a_ssert< (silent when it holds).
u:w_orld := { (W, g, n, m, lv) -> W }
ok := "10 = ec:c_ount u:w_orld cr:n_ew 0" a_ssert< "a new dungeon holds ten entities"
ok := "6 = 3 s_elect cr:y_ou s" a_ssert< "six turns taken"
