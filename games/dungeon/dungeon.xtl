#!/usr/bin/env xetal
## The dungeon, scripted (seed 1), with the rules of Crawl.xtl on
## lib/Ecs: the world as a matrix, what each entity is as the components
## it has, and every rule as one expression over all of them.
"cr:" u_se< "Crawl"
"ec:" u_se< "Ecs"

# A new game: the world, a row per entity slot (32) and a column per
# field (18: alive, then for each component whether the entity has it,
# then its fields); 9 entities are alive: you, two rats, two goblins,
# two potions, two piles of gold.
s := cr:n_ew 0
(W, g, n, m) := s
s_hape W
ec:c_ount W

# What each entity is, as the components it has: a row each, a 1 where
# it has hit points, attack, chase, heal, gold (its kind's table in
# dungeon.toml gives it those; nothing in the code names a kind).
cr:h_as s

# A few turns: right twice, down twice, left twice; the rat that
# sees you comes, you trade blows, and you beat it.
u:g_o := { s d -> s cr:t_urn d }
s := s u:g_o 0 1.0
s := s u:g_o 0 1.0
s := s u:g_o 1 0.0
s := s u:g_o 1 0.0
s := s u:g_o 0 -1.0
s := s u:g_o 0 -1.0
(W, g, n, m) := s
m
cr:y_ou s
pic := []S_HOW cr:d_raw s

# What the game guarantees, checked by a_ssert< (silent when it holds).
u:w_orld := { (W, g, n, m) -> W }
ok := "9 = ec:c_ount u:w_orld cr:n_ew 0" a_ssert< "a new dungeon holds nine entities"
ok := "0 = cr:s_tatus s" a_ssert< "six turns in, still playing"
