#!/usr/bin/env xetal
## The raycaster, scripted (seed 1), with the rules of Rays.xtl: one ray
## per column of the picture, every ray stepped through the grid at once
## until all of them have hit a wall.
"rc:" u_se< "Rays"

# A new game: you in the middle of the start tile, facing east (x, y in
# tiles, y down; the way you face in radians; the seconds).
s := rc:n_ew 0
rc:y_ou s

# What the rays see, one row each (120 of them, left to right): the
# wall's kind (1 to 4 its color, 5 the door), the side it was struck on
# (0 across, 1 down) and how far it is. The leftmost five, then the
# middle one: the blue wall (kind 2) five and a half tiles ahead.
r := rc:s_ees s
5 t_ake r
60 s_elect r

# Three steps ahead and a quarter turn right (twelve turns of 7.5
# degrees): the middle ray now looks south, down the corridor.
u:p_ress := { s k -> s rc:k_ey k }
u:k_eys := { s ks -> 0 = t_ally ks ? s; (s u:p_ress d_isclose f_irst ks) u:k_eys 1 d_rop ks }
s := s u:k_eys "UP" "UP" "UP"
s := s u:k_eys 12 r_eshape e_nclose "RIGHT"
rc:y_ou s
60 s_elect rc:s_ees s
pic := []S_HOW rc:d_raw s

# What the game guarantees, checked by a_ssert< (silent when it holds).
ok := "2 = f_loor f_irst 60 s_elect rc:s_ees rc:n_ew 0" a_ssert< "straight ahead at the start is the blue wall"
ok := "120 = t_ally rc:s_ees s" a_ssert< "a ray for every column"
ok := "0 = rc:s_tatus s" a_ssert< "still inside"
